# NFS Underground 2 in the browser: the server as a systemd service.
#   cp deploy/nfsu2-web.service /etc/systemd/system/ && systemctl daemon-reload && systemctl enable --now nfsu2-web
# Paths: the bundle in /opt/nfsu2-web, the game folder in /srv/nfsu2/game
# (readable by everyone: chmod -R u=rwX,go=rX), state (the ETag key, the switch's addresses) in
# /var/lib/nfsu2-web.  Logs: journalctl -u nfsu2-web.
# Pick ONE ExecStart:
[Unit]
Description=NFS Underground 2 in the browser (web server)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# the bundle's folder: the page (web/dist) and the game module (out/web) are in it
Environment=NFSU2_REPO=/opt/nfsu2-web
# --host: the name players open; behind a proxy the server needs it (it answers only for its own names, so a
#    page of another site whose name points here gets nothing).  Put your name in place of game.example.com.
# A: behind Caddy or nginx on this VPS (they do TLS); with Cloudflare's proxy (orange cloud) in front of
#    Caddy, add --real-ip-header cf-connecting-ip (and use the Caddyfile's Cloudflare variant)
ExecStart=/opt/nfsu2-web/nfsu2-server --data /srv/nfsu2/game --state /var/lib/nfsu2-web --behind-proxy --http-port 8080 --host game.example.com --max-peers 2000
# D: behind a Cloudflare Tunnel (cloudflared on this VPS does TLS; the client's address comes from its
#    CF-Connecting-IP header)
#ExecStart=/opt/nfsu2-web/nfsu2-server --data /srv/nfsu2/game --state /var/lib/nfsu2-web --behind-proxy --http-port 8080 --host game.example.com --real-ip-header cf-connecting-ip --max-peers 2000
# B: this server does TLS itself with a Let's Encrypt or Cloudflare Origin CA certificate on port 443,
#    IPv6 and IPv4 (an AAAA record works; --bind 0.0.0.0 for IPv4 only); its names come from the certificate
#    (systemd hands the files to the service, so they stay readable by root only; restart after a renewal)
#ExecStart=/opt/nfsu2-web/nfsu2-server --data /srv/nfsu2/game --state /var/lib/nfsu2-web --port 443 --http-port 0 --tls-cert %d/tls.crt --tls-key %d/tls.key --max-peers 2000
#LoadCredential=tls.crt:/etc/letsencrypt/live/game.example.com/fullchain.pem
#LoadCredential=tls.key:/etc/letsencrypt/live/game.example.com/privkey.pem
#AmbientCapabilities=CAP_NET_BIND_SERVICE
#CapabilityBoundingSet=CAP_NET_BIND_SERVICE
#    add --trusted-proxies cloudflare when Cloudflare's proxy (orange cloud) connects to it, and turn on Authenticated
#    Origin Pulls in Cloudflare (SSL/TLS, Origin Server): a connection from Cloudflare's addresses must then show its
#    origin-pull certificate, since any Cloudflare customer connects from them too
Restart=on-failure
RestartSec=2
# memory: the server uses about 110-250 MB, plus up to 8 MB queued towards each player who falls behind
# (a few at a time; all 2000 at once would be 16 GB); whatever happens, it never takes the VPS's memory from the rest (above
# MemoryHigh the kernel reclaims from it first; at MemoryMax it is stopped and restarted).  A 4 GB VPS.
MemoryHigh=2G
MemoryMax=3G
MemorySwapMax=0
# no account of its own: a fresh unprivileged user each start
DynamicUser=yes
StateDirectory=nfsu2-web
StateDirectoryMode=0700
WorkingDirectory=/opt/nfsu2-web
ReadOnlyPaths=/opt/nfsu2-web /srv/nfsu2/game
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
# no AF_NETLINK: the server never reads this machine's network interfaces
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
SystemCallArchitectures=native
UMask=0077
LimitNOFILE=32768
# the server already limits the lines one client can cause; this keeps the journal for the rest of the VPS
# whatever happens (journald's default is 10000 lines per 30 s for each service)
LogRateLimitIntervalSec=30s
LogRateLimitBurst=2000

[Install]
WantedBy=multi-user.target

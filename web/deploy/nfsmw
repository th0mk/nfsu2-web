#!/bin/sh
# The operator's commands to NFS Most Wanted's game server (compose.mw.yml), as ./nfsu2 is Underground 2's
# (docs/web/VPS.md, "Kick and ban"): copy it next to compose.mw.yml (/srv/nfsmw), chmod +x, then
#   ./nfsmw who [name]                     the players on the switch, and who left in the last hour
#   ./nfsmw kick <player> [message]        off playing with others, with that message (a reload brings them back)
#   ./nfsmw ban <player> <for> [message]   off until the ban ends: <for> is 30m, 12h, 3d, 2w or perm
#   ./nfsmw unban <name | #ban>            lift a ban
#   ./nfsmw bans                           the bans
# <player> is an address (10.77.x.y) or a name, as `who` shows them; the message needs no quotes.  Run it on the box
# itself: its own server, state folder and bans (the server's control socket in Most Wanted's state volume).
cd "$(dirname "$0")" && exec docker compose exec -T server /app/nfsu2-server ctl --game mw "$@"
